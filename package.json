{
  "name": "antigravity-cli-statusline",
  "version": "2.1.0",
  "description": "Monitor and customize Antigravity CLI & Antigravity App (2.0) statusline across macOS / Linux / Windows.",
  "type": "module",
  "scripts": {
    "test": "node --test skills/agy-cli-statusline/scripts/tests/core-and-registry.test.mjs skills/agy-cli-statusline/scripts/tests/quota-and-context.test.mjs skills/agy-cli-statusline/scripts/tests/render-and-i18n.test.mjs skills/agy-cli-statusline/scripts/tests/probes-and-gating.test.mjs skills/agy-cli-statusline/scripts/tests/versions.test.mjs skills/agy-cli-statusline/scripts/tests/runtime-model.test.mjs skills/agy-cli-statusline/scripts/tests/plugin-update.test.mjs skills/agy-cli-statusline/scripts/tests/configure-and-diagnose.test.mjs skills/agy-cli-statusline/scripts/tests/fetch-local-quota.test.mjs skills/agy-cli-statusline/scripts/tests/generate-svg-demos.test.mjs scripts/tests/hook-record-session.test.mjs scripts/tests/transcript-reader.test.mjs scripts/tests/mcp-server-and-service.test.mjs scripts/tests/sync-contract.test.mjs && node skills/agy-cli-statusline/scripts/test-counters.mjs",
    "sync:resources": "node skills/agy-cli-statusline/scripts/sync-resources.mjs",
    "build:svg": "node skills/agy-cli-statusline/scripts/generate-svg-demos.mjs",
    "build:app": "node scripts/build-app.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "esbuild": "^0.28.2"
  },
  "author": "andyawd",
  "license": "MIT"
}
